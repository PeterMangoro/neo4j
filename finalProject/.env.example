# Copy to `.env` in this directory and fill in values. Do not commit `.env`.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# Optional: Neo4j 4+ database name so this project only uses that graph (create it in Neo4j Desktop).
# Leave unset to use the default database (usually `neo4j`).
# NEO4J_DATABASE=supplychain

# Optional: absolute path to this database's Neo4j "import" folder (for LOAD CSV file:///…).
# Neo4j Desktop: open the DB → … → Open folder → Import. Paste that path here so the notebook can copy CSVs.
# NEO4J_IMPORT_DIR=/path/to/your/neo4j-db/import
