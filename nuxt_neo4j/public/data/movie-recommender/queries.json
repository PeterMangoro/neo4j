  {
    "id": "eda-size",
    "title": "Graph size",
    "description": "Node and relationship counts after enrichment.",
    "cypher": "MATCH (n) RETURN labels(n)[0] AS label, count(*) AS count\nORDER BY count DESC\nUNION ALL\nMATCH ()-[r]->() RETURN type(r) AS label, count(*) AS count",
    "columns": [
      "label",
      "count"
    ],
