  {
    "id": "eda-overlap",
    "title": "High-overlap user pairs",
    "description": "Users who co-rated the most movies, with average absolute rating difference.",
    "cypher": "MATCH (u1:User)-[:RATED]->(m:Movie)<-[:RATED]-(u2:User)\nWHERE u1.userId < u2.userId\nWITH u1, u2, count(m) AS coRated, avg(abs((u1)-[:RATED]->(m)).rating - ((u2)-[:RATED]->(m)).rating) AS avgAbsDiff\nRETURN u1.userId AS user1, u2.userId AS user2, coRated, round(avgAbsDiff,2) AS avgAbsDiff\nORDER BY coRated DESC LIMIT 10",
    "columns": [
      "user1",
      "user1Name",
      "user2",
      "user2Name",
      "coRated",
      "avgAbsDiff"
    ],
